{
  "name": "academiai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:production": "node scripts/smoke-build.mjs",
    "format": "prettier --write src tests scripts *.ts *.json .github README.md docs/*.md",
    "format:check": "prettier --check src tests scripts *.ts *.json .github README.md docs/*.md",
    "check": "pnpm format:check && pnpm test && pnpm build && pnpm test:production"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "canvas-confetti": "1.9.4",
    "katex": "0.19.0",
    "lucide-react": "1.59.0",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "1.9.0",
    "@types/katex": "0.16.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
